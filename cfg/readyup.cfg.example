# Ready Up runtime config.
#
# Lives next to the shim: game/csgo/readyup/bin/linuxsteamrt64/readyup.cfg
# The release installer creates it from this example only if it is missing, so your
# edits survive upgrades. Apply changes in-game with: .ru reload
#
# Booleans: 0/1 (or n/y, f/t).
debug=0
chat_debug=0
banner=1
# Per-player "Ready Up is live" center screen on first T/CT join each map.
welcome=1

# DEBUG ONLY: bots on CT/T count as always-ready scrim players, so one human can
# test ready -> live with bots. Never enable on a real match server.
# (env override: READYUP_DEV_BOTS_READY)
dev_bots_ready=0

# DEBUG ONLY: a scrim starts and runs with only bots on CT and T (no humans): scrim warmup,
# countdown, knife, live. For scripts/livetest --scrim. Never enable on a real server.
# (env override: READYUP_DEV_BOTS_SCRIM; console: ru_dev_bots_scrim 0|1|cfg)
dev_bots_scrim=0

# Prefixes (supports ChatColors tokens like <DarkRed>, <Default>, <LightBlue>, <Orange>, ...).
# Ready Up always adds a single space after the prefix in output.
chat_prefix=<DarkRed>[Ready Up]<Default>
admin_prefix=<DarkRed>[Admin]<Default>

# Local status endpoint (docs/FLEET.md §17): read-only HTTP for csm / uptime checks / curl.
# GET /health /status /stream (SSE) /metrics /selftest. Loopback clients need no token; others
# send `Authorization: Bearer <token>`. Port + token are written to csgo/readyup/status.json.
# status_http_enabled=1
# status_http_bind=127.0.0.1
# status_http_port=0          (0 = game port + 7, e.g. 27022 for 27015)
# status_http_token=          (empty = generated once and kept in status.json)
# status_http_metrics=0

# Match rules (readyup-match). Scrims use these; a match config's own values win for matches.
# max_tech_pauses_per_team=3     technical pauses (.tech/.pause) per team per map, 0 = unlimited
# tech_pause_max_seconds=300     auto-unpause after this long, 0 = never
# both_teams_unpause_required=1  0 = the pausing team alone can unpause
# allow_force_ready=1            .forceready readies the caller's team
# min_players_to_ready=0         players a team needs connected to go live / force ready (0 = all)
# forfeit_after_seconds=240      a team with nobody connected on a live map forfeits, 0 = off
# Tactical timeouts (.tac) are CS2's: mp_team_timeout_max / mp_team_timeout_time (ReadyUp/live.cfg).

# Idle map refresh: after this many hours on one map with no match loaded and nobody connected,
# load the same map again (0 = off). Long uptime on one map makes player animations run in slow
# motion; a map load fixes it. Loading a match always changes map, also onto the current one.
# idle_map_refresh_hours=12

# Ruleset for loaded matches (docs/ESPORTS-MODE.md): default (ReadyUp/live.cfg, MatchZy-style) |
# valve (Valve's CS Major rules: ReadyUp/esports_live.cfg, no knife rounds, skins plugin inert).
# A match config's "ruleset" (and its "overrides") wins. Scrims use this one.
ruleset=default
# Models the default_models override resets players to (off unless a match config turns it on):
# default_model_ct=agents/models/ctm_sas/ctm_sas.vmdl
# default_model_t=agents/models/tm_phoenix/tm_phoenix.vmdl

# Plugin settings. Everything after the first [section] line belongs to a plugin and is read
# with ru_api config_get (the plugin's own csgo/cfg/ReadyUp/<plugin>.cfg wins over this).
# Core keys must stay above the first section.
# [hello]
# greeting=hi there
