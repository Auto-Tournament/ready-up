# Ready Up runtime config.
#
# Lives next to the shim: game/csgo/readyup/bin/linuxsteamrt64/readyup.cfg
# The release installer creates it from this example only if it is missing, so your
# edits survive upgrades. Apply changes in-game with: .ru reload
#
# Booleans: 0/1 (or n/y, f/t).
debug=0
chat_debug=0
banner=1
# Per-player "Ready Up is live" center screen on first T/CT join each map.
welcome=1

# DEBUG ONLY: bots on CT/T count as always-ready scrim players, so one human can
# test ready -> live with bots. Never enable on a real match server.
# (env override: READYUP_DEV_BOTS_READY)
dev_bots_ready=0

# Prefixes (supports ChatColors tokens like <DarkRed>, <Default>, <LightBlue>, <Orange>, ...).
# Ready Up always adds a single space after the prefix in output.
chat_prefix=<DarkRed>[Ready Up]<Default>
admin_prefix=<DarkRed>[Admin]<Default>

# Local status endpoint (docs/FLEET.md §17): read-only HTTP for csm / uptime checks / curl.
# GET /health /status /stream (SSE) /metrics /selftest. Loopback clients need no token; others
# send `Authorization: Bearer <token>`. Port + token are written to csgo/readyup/status.json.
# status_http_enabled=1
# status_http_bind=127.0.0.1
# status_http_port=0          (0 = game port + 7, e.g. 27022 for 27015)
# status_http_token=          (empty = generated once and kept in status.json)
# status_http_metrics=0

# Plugin settings. Everything after the first [section] line belongs to a plugin and is read
# with ru_api config_get (the plugin's own csgo/cfg/ReadyUp/<plugin>.cfg wins over this).
# Core keys must stay above the first section.
# [hello]
# greeting=hi there
